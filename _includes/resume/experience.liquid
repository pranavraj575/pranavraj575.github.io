<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign experience = data[1] | sort: 'startDate' | reverse %}
  {% for content in experience %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.dateList %}
            {% assign date_list = "" %}
            {% for datelistitem in content.dateList %}
              {% assign temp_date = "" %}
              {% for tttt in datelistitem %}
                {% assign temp_date = temp_date | append: tttt | append: "_" %}
              {% endfor %}
              {% assign temp_date = temp_date | split: "_" %}
              {% assign startDate = temp_date[0] %}
              {% assign endDate = temp_date[1] %}

              {% include date.liquid startDate=startDate endDate=endDate range=true %}

              {% assign temp_date = date | split: " - " | join: "_" %}
              {% assign date_list = date_list | append: temp_date | append: ";" %}
            {% endfor %}
          {% else %}
            {% if content.startDate %}
              {% include date.liquid startDate=content.startDate endDate=content.endDate range=true %}
            {% else %}
              {% assign date = '' %}
            {% endif %}
            {% assign date_list = date | split: " - " | join: "_" | append: ";" %}
          {% endif %}
          {% assign date_list = date_list | split: ";" %}
          <table class="table-cv">
            <tbody>
              {% for tempdate in date_list %}
              <tr>
                <td>
                  {% assign display_date = tempdate | split: "_" | slice: 0,2 | join: " - " %}
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ display_date }} </span>
                </td>
              </tr>
              {% endfor %}
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
              {% if content.logo %}
                <tr>
                  <td>
                    <img src="{{ content.logo }}" class="img-fluid" loading="eager">
                  </td>
                </tr>
              {% endif %}

            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.position }}</a>
            {% else %}
              {{ content.position }}
            {% endif %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem"><b>{{ content.name }}</b>{% if content.subname %} - {{ content.subname }}{% endif %}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
          <ul class="items">
            {% for item in content.highlights %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
