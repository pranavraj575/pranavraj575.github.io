<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <li class="list-group-item">
      <div class="row">
        <div class="col col-md-2 text-center date-column" {% if content.preview %} style="padding-left: 0px;padding-right: 0px;" {% endif %}>
          {% if content.releaseDate %}
            {% include date.liquid startDate=content.releaseDate range=false writeDay=true %}
          {% else %}
            {% assign date = '' %}
          {% endif %}
          <!-- <table class="table-cv"> -->
          <table class="table-cv" {% if data[0] == 'publications' %} style="display:inline-block"{% endif %}>
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                </td>
              </tr>
              {% if data[0] == 'presentations' and content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
              {% if content.preview %}
                {% if content.preview contains '://' %}
                  {% assign entry_path = content.preview %}
                {% else %}
                  {% assign entry_path = content.preview | prepend: '/assets/img/publication_preview/' %}
                {% endif %}
                <tr>
                  <td>
                    {%
                      include figure.liquid
                      loading="eager"
                      path=entry_path
                      sizes = "200px"
                      class="preview z-depth-1"
                      zoomable=true
                      avoid_scaling=true
                      alt=content.preview
                      title=content.name
                    %}
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.name }}</a>
            {% else %}
              {{ content.name }}
            {% endif %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
            {% assign author_array = content.authors | split: " and " %}
            {% include author_list.liquid author_array=author_array annotation=null %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size:0.95rem;font-style:italic;">{{ content.publisher }}</h6>
          {% if content.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
          {% endif %}
          {% if content.note %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.note }}</h6>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
