<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% include date.liquid startDate=content.startDate endDate=content.endDate range=true %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if date %}
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                  {% endif %}
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.institution }}</a>
            {% else %}
              {{ content.institution }}
            {% endif %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.studyType }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.area }}</h6>
          {% if content.score %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">GPA: {{ content.score }}</h6>
          {% endif %}
          {% comment %} could put content.topics here if needed, though down there is better for space {% endcomment %}
        </div>
      </div>

      {% if content.topics %}
        {% assign num_topics = 0 %}
        {% for topic in content.topics %}
          {% assign num_topics = num_topics | plus: 1 %}
        {% endfor %}
        {% assign topic_width = 6 %}
        {% if num_topics == 1 %}
          {% assign topic_width = 12 %}
        {% endif %}
        {% if num_topics == 1 %}
          {% assign double_width = true %}
        {% else %}
          {% assign double_width = false %}
        {% endif %}
        <div class="list-groups">
          <div class="col-md-12" style="margin-bottom:3px;text-align:center"><b>Relevant Coursework</b></div>
          {% for topic in content.topics %}
            <div class="list-group col-md-{{ topic_width }}{% if topic.silly %} silly-goose{% endif %}">
              {% if double_width %}
              <div class="list-groups col-md-12" style="padding-left: 0px;padding-right: 0px;">
                {% for course in topic.courses %}
                  <div class="list-group list-group-name col-md-6" style="margin-bottom: 0px;">
                    <table class="table-cv list-group-table table-dark">
                      <tr> <td class="list-group-category-icon"></td> </tr>
                      <tr> <td></td>
                        <td class="list-group-name"{% if course.id %} title="{{ course.id }}"{% endif %}>
                          {% if course.url %}
                            <a href="{{ course.url }}" style="color:var(--global-text-color)"><b>{{ course.name }}</b></a>
                          {% else %}
                            <b>{{ course.name }}</b>
                          {% endif %}
                        </td>
                      </tr>
                    </table>
                  </div>
                {% endfor %}
              </div>
              {% else %}
              <table class="table-cv list-group-table"><tbody>
                  <tr>
                    {% if topic.icon %}
                      <td class="list-group-category-icon">
                        <i class="{{ topic.icon }}"></i>
                      </td>
                    {% else %}
                      <td class="list-group-category-icon"></td>
                    {% endif %}
                    <!-- Calculate colspan number for category title -->
                    {% assign i = 1 %}
                    {% for course in topic.courses %}
                      {% assign i = i | plus: 1 %}
                    {% endfor %}
                    {% if topic.name %}
                        <td colspan="{{ i }}" class="list-group-category"><i>{{ topic.name }}</i></td>
                    {% endif %}
                  </tr>
                  {% for course in topic.courses %}
                    <tr{% if course.silly %} class="silly-goose display-style-table-row"{% endif %}>
                      <td></td>
                      <td class="list-group-name"{% if course.id %} title="{{ course.id }}"{% endif %}>
                        {% if course.url %}
                          <a href="{{ course.url }}" style="color:var(--global-text-color)"><b>{{ course.name }}</b></a>
                        {% else %}
                          <b>{{ course.name }}</b>
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
              </tbody></table>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </li>
  {% endfor %}
</ul>
