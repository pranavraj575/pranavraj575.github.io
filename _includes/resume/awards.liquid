<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item {% if content.silly %}silly-goose{% endif %}" display-style="block" style="display:block;">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.dateList %}
            {% assign date_list = "" %}
            {% for datelistitem in content.dateList %}
              {% include date.liquid startDate=datelistitem range=false writeDay=true %}
              {% assign date_list = date_list | append: date | append: ";" %}
            {% endfor %}
          {% else %}
            {% if content.date %}
              {% include date.liquid startDate=content.date range=false writeDay=true %}
              {% assign date_list = date | append: ";" %}
            {% else %}
              {% assign date = '' %}
            {% endif %}
          {% endif %}
          {% if date_list %}
            {% assign date_list = date_list | split: ";" %}
            {% for tempdate in date_list %}
              <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ tempdate }} </span>
            {% endfor %}
          {% endif %}
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.title }}</a>
            {% else %}
              {{ content.title }}
            {% endif %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.awarder }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
