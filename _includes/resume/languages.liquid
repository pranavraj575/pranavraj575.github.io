<div class="list-groups">
  {% for content in data[1] %}
    <div class="list-group col-md-3">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon"></td>
            {% endif %}
            {% if content.ico_icon %}
              {% assign language_icon = {% include figure.liquid path=content.ico_icon class="img-fluid z-depth-1" zoomable=false %} %}
            {% else %}
              {% if content.icon %}
                {% assign language_icon = { content.icon }}&nbsp;&nbsp; %}
              {% else %}
                {% assign language_icon = &nbsp;&nbsp;•&nbsp;&nbsp; %}
              {% endif %}
            {% endif %}
            <td colspan="1" class="list-group-name">
              {{ language_icon }}{{ content.language }}{% if content.fluency %}(content.fluency){% endif %}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
