<div class="list-groups" style="padding-top:13px">
  {% assign num_languages = 0 %}
  {% for content in data[1] %}
    {% assign num_languages = num_languages | plus: 1 %}
  {% endfor %}
  {% if num_languages < 4 %}
    {% assign language_colwidth = 12 | divided_by: num_languages %}
  {% else %}
    {% assign rows_if_three_per_row = num_languages times: 1.0 | divided_by: 3.0 | ceil %}
    {% assign rows_if_four_per_row = num_languages times: 1.0 | divided_by: 4.0 | ceil %}
    {% if rows_if_three_per_row <= rows_if_four_per_row %}
      {% assign language_colwidth = 4 %}
    {% else %}
      {% assign language_colwidth = 3 %}
    {% endif %}
  {% endif %}
  {% for content in data[1] %}
    {% assign language_body = content.name %}
    {% if content.fluency %}
      {% assign language_body = language_body | append: " (" | append: content.fluency | append: ")"%}
    {% endif %}
    {% if content.blind %}
      {% assign language_body_list = language_body | split: "" %}
      {% assign language_body = "" %}
      {% for c in language_body_list %}
        {% assign charhere = "<span class='hidden_until_touch' style='color:var(--global-card-bg-color);-webkit-user-select:none;-ms-user-select:none;user-select:none;'>" %}
        {% assign charhere = charhere | append: c | append: "</span>" %}
        {% assign language_body = language_body | append: charhere %}
      {% endfor %}
    {% endif %}
    {% if content.silly_ico_icon %}
    <div class="list-group col-md-{{ language_colwidth }} silly-goose">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            <td colspan="1" class="list-group-name">
                <h6 class="ml-1 ml-md-0" style="font-size: 0.95rem">
                  <img src={{ content.silly_ico_icon }} class="img-fluid" height="auto" loading="eager" width="19 rem" title={{ content.name }}>&nbsp;&nbsp;
                  {% if content.audio %}
                    <a href="{{ content.audio }}" style="text-decoration:none;color:var(--global-text-color)">
                  {% endif %}
                  {{ language_body }}
                  {% if content.audio %}
                    </a>
                  {% endif %}
                </h6>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    {% endif %}
    <div class="list-group col-md-{{ language_colwidth }}{% if content.silly_ico_icon %} serious-goose{% endif %}">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            <td colspan="1" class="list-group-name">
              <h6 class="ml-1 ml-md-0" style="font-size: 0.95rem">
                {% if content.ico_icon %}
                  <img src={{ content.ico_icon }} class="img-fluid" height="auto" loading="eager" width="19 rem" title={{ content.name }}>&nbsp;&nbsp;
                {% else %}
                  {% if content.icon %}
                    {{ content.icon }}&nbsp;&nbsp;
                  {% else %}
                    &nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;&nbsp;
                  {% endif %}
                {% endif %}
                {% if content.audio %}
                  <a href="{{ content.audio }}" style="text-decoration:none;color:var(--global-text-color)">
                {% endif %}
                {{ language_body }}
                {% if content.audio %}
                  </a>
                {% endif %}
              </h6>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
