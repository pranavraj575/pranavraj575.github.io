<div class="list-groups" style="padding-top:13px">
  {% assign num_languages = 0 %}
  {% for content in data[1] %}
    {% assign num_languages = num_languages | plus: 1 %}
  {% endfor %}
  {% if include.num_cols %}
    {% assign num_cols = include.num_cols %}
  {% else %}
    {% assign num_cols = 4 %}
  {% endif %}
  {% if num_languages < num_cols %}
    {% assign language_colwidth = 12 | divided_by: num_languages %}
  {% else %}
    {% if num_cols == 4 %}
        {% assign rows_if_three_per_row = num_languages times: 1.0 | divided_by: 3.0 | ceil %}
        {% assign rows_if_four_per_row = num_languages times: 1.0 | divided_by: 4.0 | ceil %}
        {% if rows_if_three_per_row <= rows_if_four_per_row %}
          {% assign language_colwidth = 4 %}
        {% else %}
          {% assign language_colwidth = 3 %}
        {% endif %}
    {% else %}
        {% assign language_colwidth = 12 | divided_by: num_cols %}
    {% endif %}
  {% endif %}
  {% for content in data[1] %}
    {% assign language_body = content.name %}
    {% if content.fluency %}
      {% assign language_body = language_body | append: " (" | append: content.fluency | append: ")"%}
    {% endif %}
    {% if content.blind %}
      {% assign language_body_list = language_body | split: "" %}
      {% assign language_body = "" %}
      {% for c in language_body_list %}
        {% assign charhere = "<span class='hidden_until_touch'>" %}
        {% assign charhere = charhere | append: c | append: "</span>" %}
        {% assign language_body = language_body | append: charhere %}
      {% endfor %}
    {% endif %}
    <div class="list-group col-md-{{ language_colwidth }}">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            <td colspan="1" class="list-group-name">
              <h6 class="ml-1 ml-md-0" style="font-size:0.95rem"{% if content.audio %} onclick="plAudio('{{ content.audio }}')"{% endif %}>
                {%- if content.silly_ico_icon -%}
                  <span class="silly-goose display-style-inline-block" style="width:20px;text-align:center;display:none;">
                    <img src={{ content.silly_ico_icon }} class="img-fluid" loading="eager" style="height:0.95rem" title={{ content.name }}>
                  </span>
                {%- endif -%}
                <span
                    {% if content.silly_ico_icon %} class="serious-goose display-style-inline-block"{% endif %}
                    style=width:20px;text-align:center;{% if content.silly_ico_icon %}display:none;{% else %}display:inline-block;{% endif %}"
                    >
                  {%- if content.ico_icon -%}
                    <img src={{ content.ico_icon }} class="img-fluid" style="height:0.95rem" loading="eager" title={{ content.name }}>
                  {%- else -%}
                    {%- if content.icon -%}
                      {{ content.icon }}
                    {%- else -%}
                      •
                    {%- endif -%}
                  {%- endif -%}
                </span>&nbsp;&nbsp;
                {{ language_body }}
              </h6>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
