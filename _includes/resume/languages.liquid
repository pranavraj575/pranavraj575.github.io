<div class="list-groups">
  {% for content in data[1] %}
    <div class="list-group col-md-3">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon"></td>
            {% endif %}
            <td colspan="1" class="list-group-name">
              {% if content.ico_icon %}
                <img src={{ content.ico_icon }} class="img-fluid z-depth-1" height="auto" loading="eager" width="10 rem">&nbsp;&nbsp;
              {% else %}
                {% if content.icon %}
                  {{ content.icon }}&nbsp;&nbsp;
                {% else %}
                  &nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;
                {% endif %}
              {% endif %}
              {{ content.language }}{% if content.fluency %}(content.fluency){% endif %}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
