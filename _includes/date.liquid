
{% if include.startDate and include.startDate != '' %}
    {% if include.writeDay %}
        {% assign date = include.startDate | split: '-' | join: '.' %}

        {% assign tempdate = include.startDate | split: '-' %}
        {% assign date = tempdate | slice: 1,3 | join: '/' %}
        {% assign date = date | append: "/" | append: tempdate[0] %}
    {% else %}
        {% assign date = include.startDate | split: '-' | slice: 0, 2 | join: '.' %}

        {% assign tempdate = include.startDate | split: '-' | slice: 0, 2 | reverse %}
        {% assign date = tempdate | join: '/' %}
    {% endif %}
    {% if include.range %}
        {% if include.endDate %}
            {% if include.writeDay %}
                {% assign endDate = include.endDate | split: '-' | join: '.' | default: 'Present' %}

                {% assign tempdate = include.endDate | split: '-' %}
                {% assign endDate = tempdate | slice: 1,3 | join: '/' %}
                {% assign endDate = endDate | append: "/" | append: tempdate[0] %}
            {% else %}
                {% assign endDate = include.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}

                {% assign tempdate = include.endDate | split: '-' | slice: 0, 2 | reverse %}
                {% assign endDate = tempdate | join: '/' %}
            {% endif %}
        {% else %}
            {% assign endDate = 'Present' %}
        {% endif %}
        {% assign date = date | append: ' - ' %}
        {% assign date = date | append: endDate %}
    {% endif %}
{% else %}
    {% assign date = null %}
{% endif %}