<script>
  var coll = document.getElementsByClassName("my_collapsible");
  for (var i = 0; i < coll.length; i++) {
    coll[i].addEventListener("click", function() {
      this.classList.toggle("active");
      var my_collapsible_content = this.nextElementSibling;
      if (this.classList.contains("active")) {
        my_collapsible_content.style.display = "inherit";
      } else {
        my_collapsible_content.style.display = "none";
      }
    });
  }
</script>
{% if page.expand_all_button %}
  <script>
    var expanding_things = document.getElementsByClassName("expanding-all");
    for (var i = 0; i < expanding_things.length; i++) {
      expanding_things[i].addEventListener("click", function() {
        var coll = document.getElementsByClassName("my_collapsible");
        var all_expanded = true;
        for (var j = 0; j < coll.length; j++) {
          if (!coll[j].classList.contains("active")){
            all_expanded = false;
          }
        }
        for (var j = 0; j < coll.length; j++) {
          // if everything is expanded, we toggle all active menus
          // if everything is not expanded, we toggle all inactive menus
          if (coll[j].classList.contains("active") == all_expanded){
            coll[j].classList.toggle("active");
            var my_collapsible_content = coll[j].nextElementSibling;

            if (coll[j].classList.contains("active")) {
              my_collapsible_content.style.display = "inherit";
            } else {
              my_collapsible_content.style.display = "none";
            }
          }
        }
      });
    }
  </script>
{% endif %}

<script>
  var all_unseen = document.getElementsByClassName("hidden_until_touch");
  var left_to_reveal = all_unseen.length;
  for (var i = 0; i < all_unseen.length; i++) {
    function tadaaaa(target) {
      if (target.style.opacity != 1){
        left_to_reveal--;
        <!-- newly revealed-->
      }
      target.style.opacity = 1;
      target.style.setProperty("-webkit-user-select", "auto");
      target.style.setProperty("-ms-user-select", "auto");
      target.style.setProperty("user-select", "auto");
    }
    all_unseen[i].addEventListener("mouseover", function() {
      tadaaaa(this);
    });
    <!-- DOESNT WORK AS NEEDED ON MOBILE-->
    all_unseen[i].addEventListener("touchmove", function() {
      tadaaaa(this);
    });
  }
</script>

<script>
    function num_audios_playing() {
        pnis = document.documentElement.getAttribute('num-audios-playing');
        if (typeof(pnis) == "string") {
            return parseInt(pnis);
        }
        else {
            return 0;
        }
    }

    function plAudio(url, update_num_audios=true) {
        var audio=new Audio(url);
        if(update_num_audios){
            document.documentElement.setAttribute('num-audios-playing', num_audios_playing()+1);
            <!-- start timer after loading metadata (which includes duration) -->
            audio.onloadedmetadata = function(){
                setTimeout(() => {
                    document.documentElement.setAttribute('num-audios-playing', num_audios_playing()-1);
                }, audio.duration*1000);
            }
        }
        audio.currentTime = 0;
        audio.play();
    }

    document.addEventListener("click", function() {
        setTimeout(() => {
            if((num_audios_playing()==0) && (document.documentElement.getAttribute("goose-setting")=="silly")){
                plAudio('/assets/audio/vine_boom.mp3', update_num_audios=false);
            }
        }, 10);
    });
</script>

