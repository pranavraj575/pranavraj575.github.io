}
</script>



<script>
  for (prefix of ["","silly","serious"]){
    if ((prefix=="") || (document.documentElement.getAttribute('goose-setting')==prefix)){
      if (prefix!=""){
        prefix=prefix+"-"
      }
      for (permutator of document.getElementsByClassName(prefix+"permute-children")) {
        repeat_after=-1;
        if (permutator.hasAttribute(prefix+"permute-repeat-after")){
          repeat_after = parseInt(permutator.getAttribute(prefix+"permute-repeat-after"));
        }
        permute_children(permutator, repeat_after);
      }
    }
  }
</script>