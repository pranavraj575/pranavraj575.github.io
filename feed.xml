        scale=parseFloat(element.getAttribute("spinny-scale"));
      }
      if (element.hasAttribute("spinny-speed-boost")){
        speed_boost=parseFloat(element.getAttribute("spinny-speed-boost"));
      }
      scale=scale;
      element.style.transform='matrix('+String(scale*Math.cos(theta*speed_boost))+','+String(scale*Math.sin(theta*speed_boost))+','+String(-scale*Math.sin(theta*speed_boost))+','+String(scale*Math.cos(theta*speed_boost))+',0,0)';
      theta+=.0169;
    }
  }, '10');
</script>]]></content><author><name></name></author><category term="cat-egory"/><summary type="html"><![CDATA[]]></summary></entry></feed>